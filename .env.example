# --- Telegram ---
BOT_TOKEN=
OWNER_TELEGRAM_ID=

# --- Groq ---
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-20b

# --- Dashboard (keep host at 127.0.0.1 so only this laptop can open it) ---
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=3000
DASHBOARD_PASSWORD=

# --- Owner ---
OWNER_NAME=Kenneth Chima
OWNER_TIMEZONE=Africa/Lagos

# --- Behaviour (first-run defaults; later changes are saved from the dashboard) ---
REPLY_MODE=preview
CHAT_ACCESS_MODE=allowlist

MAX_HISTORY_MESSAGES=12
REPLY_COOLDOWN_SECONDS=20

TYPING_INDICATOR=true
